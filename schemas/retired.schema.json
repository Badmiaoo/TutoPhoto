{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retired.schema.json",
  "title": "Identifiants retirés (data/referentiel/retired.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["retired"],
  "properties": {
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "since", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^([A-Z]{3}-[0-9]{2}|SIT-(V2-)?[0-9]{2})$"},
          "merged_into": {"type": "string", "pattern": "^([A-Z]{3}-[0-9]{2}|SIT-(V2-)?[0-9]{2})$"},
          "since": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
