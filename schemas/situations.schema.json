{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "situations.schema.json",
  "title": "Catalogue des situations (data/situations.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules", "situations"],
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["level", "key_notions", "flash", "capture"]
    },
    "situations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/situation"}
    }
  },
  "$defs": {
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "level", "level_max", "where_when", "intention", "key_notions", "since"],
      "properties": {
        "id": {"type": "string", "pattern": "^SIT-(V2-)?[0-9]{2}$"},
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fr", "en"],
          "properties": {
            "fr": {"type": "string", "minLength": 1},
            "en": {"type": "string", "minLength": 1}
          }
        },
        "version": {"enum": ["V1", "V2"]},
        "level": {"enum": ["N1", "N2", "N3"]},
        "level_max": {"enum": ["N1", "N2", "N3"]},
        "where_when": {"type": "string", "minLength": 1},
        "intention": {"type": "string", "minLength": 1},
        "key_notions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"}
        },
        "capture": {"type": "string", "minLength": 1},
        "flash": {"enum": ["required", "optional"]},
        "sources": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
        },
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "since": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"}
      },
      "allOf": [
        {
          "$comment": "La capture est la scène 2.5D à produire : V1 seulement.",
          "if": {"properties": {"version": {"const": "V1"}}},
          "then": {"required": ["capture"]},
          "else": {"$comment": "une situation V2 n'a pas de champ capture", "not": {"required": ["capture"]}}
        },
        {
          "$comment": "Les identifiants SIT-V2-NN sont réservés aux situations V2, et inversement.",
          "if": {"properties": {"version": {"const": "V2"}}},
          "then": {"properties": {"id": {"pattern": "^SIT-V2-[0-9]{2}$"}}},
          "else": {"properties": {"id": {"pattern": "^SIT-[0-9]{2}$"}}}
        }
      ]
    }
  }
}
