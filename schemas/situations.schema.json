{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "situations.schema.json",
  "title": "Catalogue des situations (data/situations.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules", "situations"],
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["level", "key_notions", "flash"]
    },
    "situations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/situation"}
    }
  },
  "$defs": {
    "situation": {
      "$comment": "SIT-V2-NN : identifiants des anciennes situations V2, gardés tels quels (identifiants stables).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "level_max", "where_when", "intention", "key_notions", "since"],
      "properties": {
        "id": {"type": "string", "pattern": "^SIT-(V2-)?[0-9]{2}$"},
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fr", "en"],
          "properties": {
            "fr": {"type": "string", "minLength": 1},
            "en": {"type": "string", "minLength": 1}
          }
        },
        "level": {"enum": ["N1", "N2", "N3"]},
        "level_max": {"enum": ["N1", "N2", "N3"]},
        "where_when": {"type": "string", "minLength": 1},
        "intention": {"type": "string", "minLength": 1},
        "key_notions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"}
        },
        "flash": {"enum": ["required", "optional"]},
        "sources": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
        },
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "since": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
