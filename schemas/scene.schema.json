{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.schema.json",
  "title": "Manifeste d'une scène 3D (app/public/scenes/<scène>/scene.json)",
  "$comment": "Chaque fichier de la scène y figure, avec son origine, son auteur et sa licence (docs/licences.md). Contrôlé par scripts/check_scenes.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "situations", "assets"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"$ref": "#/$defs/bilingual"},
    "situations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SIT-(V2-)?[0-9]{2}$"}
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fr", "en"],
      "properties": {
        "fr": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "role", "authors", "source", "license", "license_url", "license_checked_at", "verified", "files"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1, "$comment": "Titre de l'œuvre sur sa page d'origine."},
        "role": {"$ref": "#/$defs/bilingual"},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source": {"type": "string", "pattern": "^https://", "$comment": "Page d'origine de l'œuvre."},
        "license": {
          "enum": ["CC0-1.0", "CC-BY-4.0"],
          "$comment": "Identifiants SPDX. Seules CC0 et CC BY sont admises pour les modèles et textures de tiers (docs/licences.md)."
        },
        "license_url": {"type": "string", "pattern": "^https://creativecommons\\.org/"},
        "license_checked_at": {"type": "string", "pattern": "^https://", "$comment": "Page où la licence a été lue."},
        "verified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "$comment": "Date de lecture de la licence."},
        "changes": {"$ref": "#/$defs/bilingual", "$comment": "Modifications apportées à l'œuvre ; obligatoire à signaler pour CC BY (section 3(a)(1)(B))."},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256", "origin"],
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "origin": {"type": "string", "pattern": "^https://", "$comment": "Adresse de téléchargement d'origine, ou du fichier source si le fichier a été modifié."}
            }
          }
        }
      }
    }
  }
}
