{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relecture.schema.json",
  "title": "Fiches relues (data/relecture.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["relues"],
  "properties": {
    "relues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fiche", "date"],
        "properties": {
          "fiche": {"type": "string", "pattern": "^([A-Z]{3}-[0-9]{2}|SIT-V2-[0-9]{2})$", "$comment": "Même forme que app/src/ficheId.mjs, SIT-V2-NN compris (constat RST-01 de l'audit, version 0.3.81)."},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
