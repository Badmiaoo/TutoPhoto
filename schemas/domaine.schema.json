{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domaine.schema.json",
  "title": "Domaine du référentiel (data/referentiel/<domaine>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "notions"],
  "properties": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "intro"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "title": {"$ref": "#/$defs/bilingue"},
        "intro": {"type": "string", "minLength": 1},
        "sources": {"$ref": "#/$defs/ids_sources"},
        "notes": {"$ref": "#/$defs/textes"},
        "todo": {"$ref": "#/$defs/textes"}
      }
    },
    "notions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/notion"}
    }
  },
  "$defs": {
    "bilingue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fr", "en"],
      "properties": {
        "fr": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "textes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "ids_sources": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "spec", "situations", "since"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
        "title": {"$ref": "#/$defs/bilingue"},
        "level": {"enum": ["N1", "N2", "N3"]},
        "activity": {"type": "boolean"},
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["explanation", "simulator", "exercise"],
          "properties": {
            "explanation": {"type": "string", "minLength": 1},
            "simulator": {"type": "string", "minLength": 1},
            "exercise": {"type": "string", "minLength": 1}
          }
        },
        "situations": {
          "oneOf": [
            {"const": "all"},
            {
              "type": "array",
              "items": {"type": "string", "pattern": "^SIT-(V2-)?[0-9]{2}$"}
            }
          ]
        },
        "practice_outside": {"type": "string", "minLength": 1},
        "sources": {"$ref": "#/$defs/ids_sources"},
        "notes": {"$ref": "#/$defs/textes"},
        "todo": {"$ref": "#/$defs/textes"},
        "since": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
