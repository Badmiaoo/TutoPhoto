{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jalons.schema.json",
  "title": "Jalons de livraison (data/jalons.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["jalons"],
  "properties": {
    "jalons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "decided", "goal", "situations", "notions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fr", "en"],
            "properties": {
              "fr": {"type": "string", "minLength": 1},
              "en": {"type": "string", "minLength": 1}
            }
          },
          "decided": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "goal": {"type": "string", "minLength": 1},
          "situations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^SIT-(V2-)?[0-9]{2}$"}
          },
          "notions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"}
          },
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
