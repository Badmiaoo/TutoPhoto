{
  "name": "tutophoto-app",
  "private": true,
  "version": "0.0.0",
  "description": "TutoPhoto : simulateur photo en 3D dans le navigateur",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && vite build --config vite.activites.config.ts && node scripts/copy-licences.mjs && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests",
    "test": "tsc --noEmit -p tests && node --import ./tests/resolve.mjs --test --test-reporter=spec \"tests/*.test.ts\""
  },
  "dependencies": {
    "@babylonjs/core": "9.35.0",
    "@babylonjs/loaders": "9.35.0",
    "babylonjs-gltf2interface": "9.35.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
